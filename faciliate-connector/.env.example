# Faciliate connector config — copy to .env and fill in (run INSIDE the SWG VPN)

# Faciliate / Landlord RestAPI server (NOT the desktop Faciliate.exe).
# Ask SWG ops for the RestAPI base URL of the JernhusenDemo install, e.g.:
# FACILIATE_BASE_URL=http://swg-app-server:7200
FACILIATE_BASE_URL=

# Auth — EITHER username/password (v2 JWT login) ...
FACILIATE_USERNAME=
FACILIATE_PASSWORD=
# ... OR a pre-configured access_token from Landlord (takes precedence if set)
FACILIATE_ACCESS_TOKEN=

# Which object types to sync (comma-separated). Adjust to real names from `test`.
FACILIATE_SYNC_OBJECTS=workorder,rentlandlord,maintenance
FACILIATE_PAGE_SIZE=200

# Geminus Supabase project (service role key — keep secret, never commit .env)
SUPABASE_URL=https://lzhlfditqujumnmfqqvq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
